# Server-only (Web Push when the app is closed + fair queue dispatch)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
CRON_SECRET=
ADMIN_PIN=

# Exact finish push. Create a token at https://console.upstash.com/qstash
# NEXT_PUBLIC_APP_URL must be the public https origin QStash can call.
# Without QSTASH_TOKEN, the minute cron still sends within about a minute.
QSTASH_TOKEN=
NEXT_PUBLIC_APP_URL=
