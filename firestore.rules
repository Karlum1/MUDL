rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function isOwner() {
      return !('ownerUid' in resource.data)
        || resource.data.ownerUid == null
        || resource.data.ownerUid == request.auth.uid;
    }

    match /machines/{machineId} {
      allow read: if true;
      allow create: if isAuth()
        && machineId.matches('^((int|chai|kan|lee|sri)-(wm|dr)-[0-9]{2}|wm-[0-9]{2})$')
        && request.resource.data.status == 'available';

      allow update: if isAuth() && (
        (
          resource.data.status in ['available', 'reserved']
          && request.resource.data.status == 'in_use'
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerName is string
          && request.resource.data.ownerName.size() > 0
          && request.resource.data.ownerName.size() <= 24
          && (!('ownerPhone' in request.resource.data)
            || request.resource.data.ownerPhone == null
            || (request.resource.data.ownerPhone is string
              && request.resource.data.ownerPhone.size() <= 12))
        )
        ||
        (
          resource.data.status == 'in_use'
          && isOwner()
          && request.resource.data.status in ['in_use', 'finished']
        )
        ||
        (
          isOwner()
          && request.resource.data.status == 'available'
          && resource.data.status in ['finished', 'in_use', 'available']
        )
      );
    }

    match /counters/{dateKey} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.nextNumber == 1;
      allow update: if isAuth()
        && request.resource.data.nextNumber == resource.data.nextNumber + 1;
    }

    match /tickets/{ticketId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in ['waiting', 'in_use'];
      allow update: if isAuth()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    match /pushTokens/{token} {
      allow read: if false;
      allow create, update: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /maintenanceLogs/{id} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.action == 'report'
        && request.resource.data.machineId is string
        && request.resource.data.machineId.size() > 0
        && request.resource.data.machineId.size() <= 32
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 200
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /machineWatches/{id} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.machineId is string
        && request.resource.data.machineId.size() > 0
        && request.resource.data.machineId.size() <= 32
        && request.resource.data.createdAt is timestamp;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /usageEvents/{id} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if false;
    }

    match /dailyStats/{dateId} {
      allow read: if true;
      allow create, update: if isAuth()
        && dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
  }
}
